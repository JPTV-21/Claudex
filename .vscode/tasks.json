{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: configure (MinGW)",
            "type": "shell",
            "command": "E:\\!Softwares\\basic\\mingw32\\bin\\cmake.exe",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}\\build",
                "-G",
                "MinGW Makefiles",
                "-DCMAKE_MAKE_PROGRAM=E:/!Softwares/basic/mingw32/bin/mingw32-make.exe",
                "-DCMAKE_CXX_COMPILER=E:/!Softwares/basic/mingw32/bin/g++.exe",
                "-DCMAKE_BUILD_TYPE=Release"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            },
            "detail": "Configure ClaudeX with the local MinGW toolchain"
        },
        {
            "label": "C/C++: Build ClaudeX",
            "type": "shell",
            "command": "E:\\!Softwares\\basic\\mingw32\\bin\\cmake.exe",
            "args": [
                "--build",
                "${workspaceFolder}\\build",
                "-j",
                "8"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "CMake: configure (MinGW)",
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            },
            "detail": "Build build/ClaudeX.exe"
        }
    ]
}
